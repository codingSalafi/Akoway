<Window x:Class="VoiceKeyboard.UI.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akoway — First Time Setup"
        Width="520" SizeToContent="Height"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#C9FE68"/>
            <Setter Property="Foreground"      Value="#0D0D0D"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="28,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8F050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#DDDDDD"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Background="#C9FE68" Padding="28,22">
            <StackPanel>
                <TextBlock Text="Welcome to Akoway"
                           FontSize="20" FontWeight="Bold" Foreground="#0D0D0D"/>
                <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="#333333"
                           TextWrapping="Wrap"
                           Text="Download the speech recognition model to get started.&#x0a;It runs fully offline — no internet required after download."/>
            </StackPanel>
        </Border>

        <!-- ── Model card ──────────────────────────────────────────────────── -->
        <StackPanel Margin="24,20,24,0">
            <TextBlock Text="Speech model" FontSize="14" FontWeight="SemiBold"
                       Foreground="#0D0D0D" Margin="0,0,0,12"/>

            <Border x:Name="CardBark" CornerRadius="10" Background="White"
                    BorderThickness="2" BorderBrush="#8ED020"
                    Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bark 3.0 Pro" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text=" · 910 MB" FontSize="13" Foreground="#777" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Highly accurate, with punctuation and capitals. Runs fast on any modern CPU — no GPU needed."
                                   FontSize="12" Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="By Underdog (Conway Research) · CC-BY 4.0"
                                   FontSize="11" Foreground="#888" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#C9FE68" CornerRadius="6"
                            Padding="8,3" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>

        <!-- ── Progress ────────────────────────────────────────────────────── -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="24,18,24,0">
            <Grid Margin="0,0,0,5">
                <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="#444"/>
                <TextBlock x:Name="TxtPercent" FontSize="12" Foreground="#444"
                           HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="PbDownload" Height="7"
                         Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Grid Margin="24,16,24,24">
            <TextBlock x:Name="TxtSkip" Text="Skip for now"
                       FontSize="12" Foreground="#888" Cursor="Hand"
                       TextDecorations="Underline" VerticalAlignment="Center"
                       MouseLeftButtonUp="TxtSkip_Click"/>
            <Button x:Name="BtnDownload" Content="Download &amp; Start"
                    Style="{StaticResource PrimaryBtn}"
                    HorizontalAlignment="Right"
                    Click="BtnDownload_Click"/>
        </Grid>

    </StackPanel>
</Window>
