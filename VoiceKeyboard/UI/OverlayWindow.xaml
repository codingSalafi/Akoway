            <Grid x:Name="PillRoot" Width="400" Height="227"
                  Background="Transparent"
                  MouseLeftButtonDown="OnMouseDown"
                  MouseMove="OnMouseMove"
                  MouseLeftButtonUp="OnMouseUp"
                  Cursor="SizeAll"
                  ToolTip="Press the hotkey or click the mic to start and stop">

                <Border x:Name="OuterPill" CornerRadius="113.5" Background="#C9FE68"/>
                <Border x:Name="InnerPill" CornerRadius="89.5" Background="#E0FFA6" Margin="24"/>

                <Canvas>
                    <!-- ── State circle ─────────────────────────────────── -->
                    <Ellipse x:Name="MicCircle" Canvas.Left="66" Canvas.Top="55"
                             Width="118" Height="118" Fill="#C9FE68"/>

