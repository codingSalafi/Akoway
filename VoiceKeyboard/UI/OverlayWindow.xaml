<Window x:Class="VoiceKeyboard.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
        <!-- Pulsing red dot for recording -->
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RecordDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15"
                             Duration="0:0:0.55"
                             AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <!--
        Two-layer pill design matching the SVG:
          Outer → background colour changes per state (#C9FE68 idle / #060900 listening)
          Inner → always #E0FFA6, offset ~16px inside the outer pill
    -->
    <Border x:Name="OuterPill"
            CornerRadius="50"
            Background="#C9FE68"
            MinWidth="460"
            MouseLeftButtonDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp"
            Cursor="SizeAll">

        <!-- Inner pill — light lime, always -->
        <Border x:Name="InnerPill"
                CornerRadius="34"
                Background="#E0FFA6"
                Margin="16"
                Padding="28,0,24,0">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Height="72">

                <!-- ── Mic icon ───────────────────────────────────────── -->
                <Viewbox Width="58" Height="58"
                         Margin="0,0,16,0"
                         VerticalAlignment="Center">

                    <!-- Canvas sized to full SVG coordinate space so paths
                         sit at their original positions. Viewbox scales it down. -->
                    <Canvas Width="232" Height="232">

                        <!-- IDLE: outline mic with sound-wave arcs -->
                        <Canvas x:Name="MicIdle" Width="232" Height="232">
                            <!-- Main mic body outline -->
                            <Path Stroke="#1A1A1A"
                                  StrokeThickness="6.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M141 98.3338V119.167C141 125.798 138.366 132.156 133.678 136.845C128.989 141.533 122.63 144.167 116 144.167C109.37 144.167 103.011 141.533 98.3223 136.845C93.6339 132.156 91 125.798 91 119.167V98.3338C91.0001 93.2708 92.5375 88.3272 95.4087 84.1571C98.2799 79.9869 102.35 76.7868 107.079 74.9802C111.809 73.1736 116.976 72.8456 121.896 74.0397C126.816 75.2337 131.258 77.8936 134.633 81.6672"/>
                            <!-- Sound-wave arcs + stand -->
                            <Path Stroke="#1A1A1A"
                                  StrokeThickness="6.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M107.667 92.0833C107.667 92.0833 109.637 90 116 90C122.362 90 124.333 92.0833 124.333 92.0833
                                        M107.667 104.583C107.667 104.583 109.637 102.5 116 102.5C122.362 102.5 124.333 104.583 124.333 104.583
                                        M153.5 110.833V119.167C153.501 126.152 151.552 132.998 147.871 138.935C144.19 144.872 138.924 149.662 132.667 152.767
                                        M78.5 110.833V119.167C78.5 129.112 82.4509 138.651 89.4835 145.683C96.5161 152.716 106.054 156.667 116 156.667"/>
                        </Canvas>

                        <!-- LISTENING: filled solid mic -->
                        <Canvas x:Name="MicActive" Width="232" Height="232"
                                Visibility="Collapsed">
                            <!-- Stand / base (filled) -->
                            <Path Fill="#000000"
                                  Data="M81.3833 108.217C82.9792 108.217 84.2708 109.521 84.2708 111.126V118.876C84.2708 136.538 98.4792 150.855 116 150.855C133.525 150.855 147.729 136.538 147.729 118.876V111.126C147.729 109.517 149.021 108.217 150.617 108.217C152.212 108.217 153.5 109.521 153.5 111.126V118.876C153.5 139.751 136.708 156.667 116 156.667C95.2917 156.667 78.5 139.751 78.5 118.876V111.126C78.5 109.517 79.7917 108.217 81.3833 108.217Z"/>
                            <!-- Main body (filled, with detail lines) -->
                            <Path Fill="#000000"
                                  Data="M116 73.3335C101.663 73.3335 90.0418 85.046 90.0418 99.5002V118.875C90.0418 133.325 101.663 145.042 116 145.042C130.338 145.042 141.958 133.325 141.958 118.875V99.5002C141.958 85.0418 130.342 73.3335 116 73.3335ZM106.325 95.7918C105.768 95.2605 105.443 94.5305 105.422 93.7608C105.401 92.9912 105.685 92.2445 106.213 91.6835L108.308 93.6835L106.217 91.6835L106.225 91.671L106.238 91.6585L106.267 91.6252L106.517 91.396C106.689 91.2514 106.867 91.1137 107.05 90.9835C107.621 90.5967 108.231 90.2726 108.871 90.0168C110.45 89.3752 112.746 88.8377 116 88.8377C119.254 88.8377 121.55 89.3752 123.129 90.0168C123.921 90.3377 124.513 90.6835 124.95 90.9835C125.228 91.1758 125.49 91.3904 125.733 91.6252L125.763 91.6585L125.775 91.671L125.783 91.6793C125.783 91.6793 125.788 91.6835 123.733 93.6418L125.788 91.6835C126.883 92.8502 126.829 94.6918 125.675 95.796C125.141 96.3042 124.431 96.5877 123.694 96.5877C122.956 96.5877 122.247 96.3042 121.713 95.796L121.683 95.7752C121.457 95.6301 121.217 95.5073 120.967 95.4085C120.167 95.0835 118.625 94.6502 116 94.6502C113.375 94.6502 111.833 95.0835 111.033 95.4085C110.783 95.5073 110.543 95.6301 110.317 95.7752L110.288 95.796C109.753 96.303 109.045 96.5857 108.308 96.5857C107.572 96.5857 106.863 96.303 106.329 95.796M106.329 107.425C105.772 106.894 105.448 106.164 105.427 105.394C105.405 104.625 105.69 103.878 106.217 103.317L106.221 103.308L106.229 103.304L106.242 103.288L106.271 103.258L106.521 103.025C106.693 102.882 106.871 102.746 107.054 102.617C107.625 102.23 108.235 101.906 108.875 101.65C110.454 101.008 112.75 100.471 116.004 100.471C119.258 100.471 121.554 101.008 123.133 101.65C123.925 101.971 124.517 102.317 124.954 102.617C125.232 102.809 125.494 103.024 125.738 103.258L125.767 103.288L125.779 103.304L125.788 103.308C125.788 103.308 125.792 103.317 123.738 105.271L125.792 103.317C126.888 104.483 126.833 106.325 125.679 107.425C125.145 107.933 124.436 108.217 123.698 108.217C122.961 108.217 122.251 107.933 121.717 107.425L121.688 107.408C121.461 107.263 121.221 107.141 120.971 107.042C120.167 106.708 118.625 106.279 116 106.279C113.375 106.279 111.833 106.713 111.033 107.038C110.783 107.136 110.543 107.259 110.317 107.404L110.288 107.425C109.753 107.932 109.045 108.215 108.308 108.215C107.572 108.215 106.863 107.932 106.329 107.425Z"/>

                            <!-- Pulsing red recording dot -->
                            <Ellipse x:Name="RecordDot"
                                     Canvas.Left="140" Canvas.Top="68"
                                     Width="16" Height="16"
                                     Fill="#E53935"/>
                        </Canvas>

                        <!-- PROCESSING: greyed-out mic -->
                        <Canvas x:Name="MicProcessing" Width="232" Height="232"
                                Visibility="Collapsed">
                            <Path Stroke="#666666"
                                  StrokeThickness="6.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Data="M141 98.3338V119.167C141 125.798 138.366 132.156 133.678 136.845C128.989 141.533 122.63 144.167 116 144.167C109.37 144.167 103.011 141.533 98.3223 136.845C93.6339 132.156 91 125.798 91 119.167V98.3338C91.0001 93.2708 92.5375 88.3272 95.4087 84.1571C98.2799 79.9869 102.35 76.7868 107.079 74.9802C111.809 73.1736 116.976 72.8456 121.896 74.0397C126.816 75.2337 131.258 77.8936 134.633 81.6672
                                        M78.5 110.833V119.167C78.5 129.112 82.4509 138.651 89.4835 145.683C96.5161 152.716 106.054 156.667 116 156.667"/>
                        </Canvas>

                    </Canvas>
                </Viewbox>

                <!-- ── Status text ───────────────────────────────────── -->
                <TextBlock x:Name="StatusText"
                           Text="Press hotkey or click mic icon to start"
                           FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
                           FontSize="22"
                           FontWeight="Medium"
                           Foreground="#0D0D0D"
                           VerticalAlignment="Center"/>

                <!-- ── Close button ──────────────────────────────────── -->
                <TextBlock Text="✕"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseLeftButtonDown="OnCloseMouseDown"
                           MouseLeftButtonUp="OnCloseClick"/>

            </StackPanel>
        </Border>
    </Border>
</Window>
