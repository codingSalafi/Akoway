<Window x:Class="VoiceKeyboard.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        Opacity="0">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
        <!-- Pulsing red dot for recording -->
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RecordDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15"
                             Duration="0:0:0.55"
                             AutoReverse="True"/>
        </Storyboard>
        <!-- Rotating loader arc while processing -->
        <Storyboard x:Key="SpinAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.9"/>
        </Storyboard>
    </Window.Resources>

    <!-- Fixed width so the pill doesn't shift when the (wider) error label appears;
         the transparent sides don't take clicks -->
    <StackPanel Width="280">

        <!--
            Pill drawn in the Figma frame's own coordinates (400 x 227) and scaled
            down to 183 x 104 by the Viewbox. Every position and path below comes
            from the design export, so keep editing in these units.
              Outer pill → state colour (#C9FE68 idle, #96E600 active, #E53935 error)
              Inner pill → always #E0FFA6
              Circle     → state colour + state icon
        -->
